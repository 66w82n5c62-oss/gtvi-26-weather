+
+function bearingDeg(a,b){
+  const toRad=x=>x*Math.PI/180, toDeg=x=>x*180/Math.PI;
+  const p1=toRad(a.lat), p2=toRad(b.lat), dl=toRad(b.lon-a.lon);
+  const y=Math.sin(dl)*Math.cos(p2);
+  const x=Math.cos(p1)*Math.sin(p2)-Math.sin(p1)*Math.cos(p2)*Math.cos(dl);
+  return (toDeg(Math.atan2(y,x))+360)%360;
+}
+function routeBearingAtKm(s,km){
+  const line=s.line||[];
+  if(line.length<2)return null;
+  let idx=line.findIndex(p=>p.km>=km);
+  if(idx<=0)idx=1;
+  if(idx>=line.length)idx=line.length-1;
+  return bearingDeg(line[idx-1],line[idx]);
+}
+function circularMeanDeg(vals){
+  const v=vals.filter(Number.isFinite);
+  if(!v.length)return null;
+  const sy=v.reduce((a,d)=>a+Math.sin(d*Math.PI/180),0);
+  const sx=v.reduce((a,d)=>a+Math.cos(d*Math.PI/180),0);
+  return (Math.atan2(sy,sx)*180/Math.PI+360)%360;
+}
+function windEffectLabel(routeBearing,windFrom,windSpeed){
+  if(!Number.isFinite(routeBearing)||!Number.isFinite(windFrom)||!Number.isFinite(windSpeed))return null;
+  if(windSpeed<4)return {label:"Light / little effect",along:0,cross:windSpeed};
+  const windTo=(windFrom+180)%360;
+  const diff=((windTo-routeBearing+540)%360)-180;
+  const along=windSpeed*Math.cos(diff*Math.PI/180);
+  const cross=Math.abs(windSpeed*Math.sin(diff*Math.PI/180));
+  const frac=along/windSpeed;
+  let label="Crosswind";
+  if(frac>=0.70)label="Tailwind";
+  else if(frac>=0.20)label="Cross-tailwind";
+  else if(frac<=-0.70)label="Headwind";
+  else if(frac<=-0.20)label="Cross-headwind";
+  return {label,along,cross};
+}
